{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts", "extension/**/*.js"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "extension/**/*.js"]
    },
    "web": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
