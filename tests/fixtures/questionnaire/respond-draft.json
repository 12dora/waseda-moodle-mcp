      "html": "<div>\n    <core-course-module-description description=\"&lt;p&gt;Please answer by Thursday 19 November, 1 PM.&lt;/p&gt;\"\n                                    component=\"mod_questionnaire\" componentId=\"101\"\n                                    pagenum=\"1\"></core-course-module-description>\n    <div>\n        <ion-card>\n            <ion-list>\n                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">1</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"1. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Your nickname in class&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    <ion-badge slot=\"end\" color=\"danger\">{{ 'plugin.mod_questionnaire.required' | translate }}</ion-badge>\n                </ion-item>\n                    <ion-item>\n                        <ion-label>\n                        </ion-label>\n                        <ion-textarea aria-multiline=\"true\" [(ngModel)]=\"CONTENT_OTHERDATA.response_2_5001\"\n                                      core-auto-rows></ion-textarea>\n                    </ion-item>                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">2</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"2. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Where do you usually study?&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    <ion-badge slot=\"end\" color=\"danger\">{{ 'plugin.mod_questionnaire.required' | translate }}</ion-badge>\n                </ion-item>\n                    <ion-radio-group [(ngModel)]=\"CONTENT_OTHERDATA.response_4_5003\">\n                            <ion-item class=\"ion-text-wrap\">\n                                <ion-label><core-format-text text=\"Library\"></core-format-text></ion-label>