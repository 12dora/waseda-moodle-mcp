    {
      "id": "main",
      "html": "<div>\n    <core-course-module-description description=\"&lt;p&gt;Please answer by Thursday 19 November, 1 PM.&lt;/p&gt;\"\n                                    component=\"mod_questionnaire\" componentId=\"101\"\n                                    pagenum=\"1\"></core-course-module-description>\n    <ion-card>\n        <ion-card-content>\n            <div class=\"notifyproblem\">Please answer the required question #3.</div>\n        </ion-card-content>\n    </ion-card>\n    <div>\n        <ion-card>\n            <ion-list>\n                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">1</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"1. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Your nickname in class&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    <ion-badge slot=\"end\" color=\"danger\">{{ 'plugin.mod_questionnaire.required' | translate }}</ion-badge>\n                </ion-item>\n                    <ion-item>\n                        <ion-label>\n                        </ion-label>\n                        <ion-textarea aria-multiline=\"true\" [(ngModel)]=\"CONTENT_OTHERDATA.response_2_5001\"\n                                      core-auto-rows></ion-textarea>\n                    </ion-item>                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">2</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"2. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;What did you learn from the guest lecture?&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    <ion-badge slot=\"end\" color=\"danger\">{{ 'plugin.mod_questionnaire.required' | translate }}</ion-badge>\n                </ion-item>\n                    <ion-item>\n                        <ion-label>\n                        </ion-label>\n                        <ion-textarea aria-multiline=\"true\" [(ngModel)]=\"CONTENT_OTHERDATA.response_3_5002\"\n                                      core-auto-rows></ion-textarea>\n                    </ion-item>                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">3</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"3. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Where do you usually study?&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    <ion-badge slot=\"end\" color=\"danger\">{{ 'plugin.mod_questionnaire.required' | translate }}</ion-badge>\n                </ion-item>\n                    <ion-radio-group [(ngModel)]=\"CONTENT_OTHERDATA.response_4_5003\">\n                            <ion-item class=\"ion-text-wrap\">\n                                <ion-label><core-format-text text=\"Library\"></core-format-text></ion-label>\n                                <ion-radio\n                                value=\"7001\"\n                                ></ion-radio>\n                            </ion-item>\n                            <ion-item class=\"ion-text-wrap\">\n                                <ion-label><core-format-text text=\"Cafeteria\"></core-format-text></ion-label>\n                                <ion-radio\n                                value=\"7002\"\n                                ></ion-radio>\n                            </ion-item>\n                            <ion-item class=\"ion-text-wrap\">\n                                <ion-label><core-format-text text=\"Other:\"></core-format-text></ion-label>\n                                <ion-radio\n                                value=\"7003\"\n                                ></ion-radio>\n                            </ion-item>\n                            <ion-item class=\"ion-text-wrap\">\n                                <ion-input placeholder=\"Enter: \" [(ngModel)]=\"CONTENT_OTHERDATA.response_4_5003_o7003\"\n                                ></ion-input>\n                            </ion-item>\n                    </ion-radio-group>                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">4</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"4. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Which materials do you use? Choose all that apply.&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    \n                </ion-item>\n                    <ion-list>\n                            <ion-item>\n                                <ion-label><core-format-text text=\"Textbook\"></core-format-text></ion-label>\n                                <ion-checkbox  value=\"7101\"\n                                \n                                [(ngModel)]=\"CONTENT_OTHERDATA.response_5_5004_7101\"></ion-checkbox>\n                            </ion-item>\n                            <ion-item>\n                                <ion-label><core-format-text text=\"Online videos\"></core-format-text></ion-label>\n                                <ion-checkbox  value=\"7102\"\n                                \n                                [(ngModel)]=\"CONTENT_OTHERDATA.response_5_5004_7102\"></ion-checkbox>\n                            </ion-item>\n                            <ion-item>\n                                <ion-label><core-format-text text=\"Study group\"></core-format-text></ion-label>\n                                <ion-checkbox  value=\"7103\"\n                                \n                                [(ngModel)]=\"CONTENT_OTHERDATA.response_5_5004_7103\"></ion-checkbox>\n                            </ion-item>\n                            <ion-item>\n                                <ion-label><core-format-text text=\"Other:\"></core-format-text></ion-label>\n                                <ion-checkbox  value=\"7104\"\n                                \n                                [(ngModel)]=\"CONTENT_OTHERDATA.response_5_5004_7104\"></ion-checkbox>\n                            </ion-item>\n                            <ion-item>\n                                <ion-input placeholder=\"Enter: \" [(ngModel)]=\"CONTENT_OTHERDATA.response_5_5004_o7104\"\n                                ></ion-input>\n                            </ion-item>\n                    </ion-list>                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">5</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"5. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Did you attend the previous session?&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    \n                </ion-item>\n                    <ion-radio-group [(ngModel)]=\"CONTENT_OTHERDATA.response_1_5005\">\n                        <ion-item class=\"ion-text-wrap\">\n                            <ion-label><core-format-text text=\"No\"></core-format-text></ion-label>\n                            <ion-radio slot=\"end\" [value]=\"0\"></ion-radio>\n                        </ion-item>\n                        <ion-item class=\"ion-text-wrap\">\n                            <ion-label><core-format-text text=\"Yes\"></core-format-text></ion-label>\n                            <ion-radio slot=\"end\" [value]=\"1\"></ion-radio>\n                        </ion-item>\n                    </ion-radio-group>                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">6</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"6. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Which campus city do you live in?&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    \n                </ion-item>\n                    <ion-item>\n                        <ion-label></ion-label>\n                        <ion-select [(ngModel)]=\"CONTENT_OTHERDATA.response_6_5006\">\n                            <ion-select-option value=\"7201\">Tokyo</ion-select-option>\n                            <ion-select-option value=\"7202\">Osaka</ion-select-option>\n                            <ion-select-option value=\"7203\">Kyoto</ion-select-option>\n                        </ion-select>\n                    </ion-item>\n\n                <ion-grid class=\"ion-text-wrap\">\n                    <ion-row>\n                        <ion-col>\n                            <ion-button expand=\"block\" fill=\"outline\" core-site-plugins-new-content component=\"mod_questionnaire\"\n                                method=\"mobile_view_activity\"\n                                [args]=\"{\n                                                cmid: 101,\n                                                rid: 0,\n                                                completeq: 1,\n                                                action: 'nextpage',\n                                                pagenum: 1\n                                            }\"\n                                [useOtherData]=\"null\"\n                                [preSets]=\"{getFromCache: 0, saveToCache: 0}\"\n                                refreshOnSuccess=\"true\"\n                                samePage=\"true\" type=\"submit\"\n                            >\n                                <ion-icon name=\"fas-chevron-right\" slot=\"end\" aria-hidden=\"true\"></ion-icon>\n                                {{ 'plugin.mod_questionnaire.nextpage' | translate }}\n                            </ion-button>\n                        </ion-col>\n                    </ion-row>\n                </ion-grid>\n                \n            </ion-list>\n        </ion-card>\n    </div>\n</div>"
    }
