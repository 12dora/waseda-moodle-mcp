      "html": "<div>\n    <core-course-module-description description=\"&lt;p&gt;Please answer by Thursday 19 November, 1 PM.&lt;/p&gt;\"\n                                    component=\"mod_questionnaire\" componentId=\"101\"\n                                    pagenum=\"1\"></core-course-module-description>\n    <div>\n        <ion-card>\n            <ion-list>\n                <ion-item class=\"ion-text-wrap\">\n                    <ion-badge color=\"dark\" slot=\"start\">7</ion-badge>\n                    <ion-label>\n                        <core-format-text text=\"7. &lt;div class=&quot;no-overflow&quot;&gt;&lt;p&gt;Rate the lecture &amp;amp; the materials.&lt;/p&gt;&lt;/div&gt;\"></core-format-text>\n                    </ion-label>\n                    <ion-badge slot=\"end\" color=\"danger\">{{ 'plugin.mod_questionnaire.required' | translate }}</ion-badge>\n                </ion-item>\n                    <ion-list>\n                        <ion-grid>\n                            <ion-row class=\"ion-align-items-center ion-justify-content-center ion-text-center\">\n                                <ion-col>\n                                    <ion-label>1</ion-label>\n                                </ion-col>\n                                <ion-col>\n                                    <ion-label>2</ion-label>\n                                </ion-col>\n                                <ion-col>\n                                    <ion-label>3</ion-label>\n                                </ion-col>\n                                <ion-col>\n                                    <ion-label>4</ion-label>\n                                </ion-col>\n                                <ion-col>\n                                    <ion-label>N/A</ion-label>\n                                </ion-col>\n                            </ion-row>\n                            <ion-row><ion-col>\n                                <ion-item style=\"margin-bottom: 0; borde